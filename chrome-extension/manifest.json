{
  "manifest_version": 3,
  "name": "HOL Genealogy Research Listener",
  "version": "1.4.0",
  "description": "Guides a genealogy Reddit workflow, captures visible Reddit text, and tests a localhost Ollama bridge.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "http://127.0.0.1:2526/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.reddit.com/*",
        "https://old.reddit.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
